#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-only
#
# uci-defaults: luci-app-dove 首次安装初始化
# dove 包已经装好 /etc/init.d/dove、/etc/config/dove、/etc/dove/config.dae
# 和 /usr/bin/dove；这里只处理权限、目录、软链与自启。

# rpcd helper 权限（个别构建里安装后可能不是 755）
chmod 0755 /usr/libexec/rpcd/luci.dove 2>/dev/null || true

# 配置目录与日志
mkdir -p /etc/dove /var/log
chmod 0700 /etc/dove 2>/dev/null || true
# 配置里可能有节点密码，收紧权限（init 每次启动也会再 chmod 一次）
chmod 0600 /etc/dove/config.dae 2>/dev/null || true
touch /var/log/dove.log 2>/dev/null || true

# geodata：core 的 geodata 目录 = 配置文件所在目录（/etc/dove），
# 同时给 /usr/share/dae 兜底（GeodataResolver 的固定搜索路径之一）。
# /etc/dove 用绝对目标（相对路径会算错，见 dove/Makefile 注释）；
# 悬空软链在 -e 判断下为假，所以这里能自动纠正旧版的错链。
[ -e /etc/dove/geoip.dat ]   || ln -sf /usr/share/v2ray/geoip.dat   /etc/dove/geoip.dat   2>/dev/null || true
[ -e /etc/dove/geosite.dat ] || ln -sf /usr/share/v2ray/geosite.dat /etc/dove/geosite.dat 2>/dev/null || true
mkdir -p /usr/share/dae
# /usr/share/dae 的 ../v2ray 是对的（同为 /usr/share 下）
[ -e /usr/share/dae/geoip.dat ]   || ln -sf ../v2ray/geoip.dat   /usr/share/dae/geoip.dat   2>/dev/null || true
[ -e /usr/share/dae/geosite.dat ] || ln -sf ../v2ray/geosite.dat /usr/share/dae/geosite.dat 2>/dev/null || true

# 让 rpcd 立刻加载新的 ACL / helper
/etc/init.d/rpcd restart

# 自启（不在安装时启动服务；由用户从 LuCI 点启动，或重启后随 rc.d 启动）
/etc/init.d/dove enable 2>/dev/null || true

return 0
