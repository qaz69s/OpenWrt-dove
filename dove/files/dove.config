# Dove (DaeNext core only) UCI 配置
#
# 自启开关不在这里：由 /etc/rc.d/S99dove 软链决定（LuCI「开机自启」=
# /etc/init.d/dove enable|disable）。init 刻意不读 enabled，
# 避免 LuCI「启动」按钮被静默拦掉。
#
# ★ 代理规则 / 节点 / 订阅不在这里 —— 在 /etc/dove/config.dae（纯文本，
#   语法与上游 dae 的 config.dae 一致）。LuCI「配置」页直接编辑那个文件。

config dove 'settings'
	# 服务开关（仅信息展示；真正决定开机启动的是 rc.d 软链）
	option enabled '1'
	# dae 配置文本
	option config_file '/etc/dove/config.dae'
	# 运行日志（core 只支持 --logfile 一个参数，没有内建轮转）
	option log_file '/var/log/dove.log'
	# 启动时按大小轮转：超过 maxsize(MB) 滚一份，最多保留 backups 份
	option logfile_maxsize '1'
	option logfile_maxbackups '3'
	# pidfile：dove reload 靠它定位进程（默认 /var/run/dove.pid）
	option pid_file '/var/run/dove.pid'
	# 重载握手文件：run 写进度、reload 写 RELOAD_SEND 并等 DONE。
	# ⚠️ run 和 reload 必须用同一组路径，所以这里可配、init 两边都传。
	option progress_file '/var/run/dove.progress'
	option abort_file '/var/run/dove.abort'
	# 启动前 `dove validate -c <config_file>`；校验失败则拒绝启动
	option validate_start '1'
	# 日志行不带时间戳（core 的 --disable-timestamp）
	option disable_timestamp '0'
	# procd
	option respawn '1'
	option respawn_threshold '3600'
	option respawn_timeout '5'
	option respawn_retry '5'
	option term_timeout '10'
	option nofile '1048576'
	option nproc '512'
