# Dove (DaeNext / daed) UCI 配置
#
# 自启开关不在这里：由 /etc/rc.d/S95dove 软链决定（LuCI「开机自启」=
# /etc/init.d/dove enable|disable）。init 刻意不读 UCI enabled，
# 避免 LuCI「启动」按钮被静默拦掉。
#
# ⚠️ 代理规则 / 节点 / 订阅不在本文件里，也不在 /etc/dove/*.dae 里：
# daed 的配置实体存在 daed.db（SQLite）中。LuCI 的「配置」页通过 REST API
# 导出/导入 dae 配置文本（GET/PUT /api/user/me/dae-config-file），
# 再 POST /api/runtime/reload 生效。

config dove 'main'
	# daed 配置目录（也存放 daed.db、输入配置快照、geodata 解析缓存）
	option config_dir '/etc/dove'
	# 产品状态库；留空/缺省即 $config_dir/daed.db
	option state '/etc/dove/daed.db'
	# 控制面监听（REST API + Web UI）；改成 127.0.0.1:2023 可只允许本机访问
	option listen '0.0.0.0:2023'
	# Web UI 根目录
	option web_root '/usr/share/dove/web'
	# daed 本地控制 socket（daed reload / wait-ready 走它）。
	# 用独立 socket 是为了能跟 deer/原生 daed 同时在机上共存。
	option control_socket '/run/dove/control.sock'
	# geodata（geoip.dat / geosite.dat）目录；留空 = web_root 的父目录（推荐）。
	# 该目录会通过 DAE_LOCATION_ASSET 传给 daed —— daed 构建/预检运行时只认这个
	# 变量、调用方传入目录和 /etc/daed 等固定目录，不认 web_root，
	# 所以别把 geodata 挪到别处而不改这里。
	# option geodata_dir '/usr/share/dove'
	# 产品日志目录（JSONL: current.jsonl）—— LuCI「日志」页读这里
	option log_dir '/tmp/log/dove'
	# HTTP worker 档位：low-memory / balanced / performance
	option http_profile 'low-memory'
	# 1=只跑控制面（不托管 Web UI 静态文件，REST/SSE 仍在）
	option api_only '0'
	# 启动前 `dove validate -c <config_dir> --state <db>`（新装空目录也能通过）
	option validate_start '1'
	# 重载前 `dove validate --runtime`（失败则拒绝重载，保留旧配置）
	option validate_reload '1'
	# 1=把 /tmp/resolv.conf 劫持到 daed DNS（默认关闭：配置不当会导致全机解析失败）
	option hijack_resolv '0'
	# daed reload 后的就绪等待：正常超时 / 失败后重启再等的超时
	option reload_ready_timeout '2s'
	option reload_recovery_timeout '30s'
	option respawn '1'
	option term_timeout '10'
	option nofile '1048576'
	option nproc '512'
