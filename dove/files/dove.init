#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: AGPL-3.0-only
#
# Dove —— DaeNext **core only**（dae-daemon 关掉 product-api：无 SQLite / 无 REST /
# 无 Web UI）的 procd 服务脚本，形态与 joey（上游 dae）一致：
#   * 配置就是一份文本 /etc/dove/config.dae
#   * 启动：dove validate -c <file> → dove run -c <file> --logfile <log>
#   * 热重载：dove reload（对进程发 SIGUSR1，不断连接）
#
# 自启由 /etc/rc.d/S99dove 软链决定（LuCI「开机自启」= enable/disable）。
# start_service 刻意不检查 UCI enabled：那会让 LuCI 的「启动」按钮静默失效
# （setInitAction('start') 直接调 start_service，不会先改 UCI 标志）。

START=99
STOP=10
USE_PROCD=1

NAME=dove
PROG="${DOVE_PROG:-/usr/bin/dove}"
DEFAULT_CONFIG_FILE=/etc/dove/config.dae
DEFAULT_LOG=/var/log/dove.log
DEFAULT_PID_FILE=/var/run/dove.pid

EXTRA_COMMANDS="hot_reload check_config"
EXTRA_HELP="        hot_reload    Hot-reload config.dae without interrupting connections
        check_config  Validate /etc/dove/config.dae (dove validate)"

load_dove_config() {
	config_load "$NAME"

	config_get_bool enabled     settings enabled             1
	config_get config_file      settings config_file         "$DEFAULT_CONFIG_FILE"
	config_get log_file         settings log_file            "$DEFAULT_LOG"
	config_get pid_file         settings pid_file            "$DEFAULT_PID_FILE"
	config_get progress_file    settings progress_file       "$(dirname "$DEFAULT_PID_FILE")/dove.progress"
	config_get abort_file       settings abort_file          "$(dirname "$DEFAULT_PID_FILE")/dove.abort"
	# core 没有内建日志轮转（--logfile 只有一个参数），启动时按大小滚动
	config_get logfile_maxsize    settings logfile_maxsize    1
	config_get logfile_maxbackups settings logfile_maxbackups 3
	config_get_bool disable_timestamp settings disable_timestamp 0
	config_get_bool validate_start    settings validate_start    1

	config_get_bool respawn         settings respawn         1
	config_get respawn_threshold    settings respawn_threshold 3600
	config_get respawn_timeout      settings respawn_timeout   5
	config_get respawn_retry        settings respawn_retry     5
	config_get term_timeout         settings term_timeout      10
	config_get nofile               settings nofile            1048576
	config_get nproc                settings nproc             512
}

_ensure_logdir() { mkdir -p "$(dirname "$log_file")"; }

# 启动时轮转：超过 maxsize(MB) 就滚一份，最多保留 backups 份
_rotate_log() {
	[ -f "$log_file" ] || return 0
	local bytes cur i
	bytes=$(( ${logfile_maxsize:-1} * 1024 * 1024 ))
	cur=$(wc -c < "$log_file" 2>/dev/null || echo 0)
	[ "$cur" -lt "$bytes" ] && return 0

	i=$(( ${logfile_maxbackups:-3} - 1 ))
	while [ "$i" -ge 1 ]; do
		[ -f "${log_file}.$i" ] && mv -f "${log_file}.$i" "${log_file}.$((i+1))" 2>/dev/null
		i=$(( i - 1 ))
	done
	mv -f "$log_file" "${log_file}.1" 2>/dev/null
	: > "$log_file"
}

# core 的 geodata 目录 = 配置文件所在目录（resident_config_geodata_asset_dirs()）。
# GeodataResolver 另外还会找 /etc/dae、/usr/local/share/dae、/usr/share/dae 等固定目录，
# 所以这里同时补一份兜底软链，留给用户放自己的 geodata 时不覆盖。
_ensure_geodata() {
	local dir; dir="$(dirname "$config_file")"
	mkdir -p "$dir" 2>/dev/null
	[ -f "$dir/geoip.dat" ]   || ln -sf ../v2ray/geoip.dat   "$dir/geoip.dat"   2>/dev/null
	[ -f "$dir/geosite.dat" ] || ln -sf ../v2ray/geosite.dat "$dir/geosite.dat" 2>/dev/null

	[ -d /usr/share/dae ] || mkdir -p /usr/share/dae 2>/dev/null
	[ -e /usr/share/dae/geoip.dat ]   || ln -sf ../v2ray/geoip.dat   /usr/share/dae/geoip.dat   2>/dev/null
	[ -e /usr/share/dae/geosite.dat ] || ln -sf ../v2ray/geosite.dat /usr/share/dae/geosite.dat 2>/dev/null
}

_check_config() {
	"$PROG" validate -c "$config_file"
}

start_service() {
	load_dove_config
	_ensure_logdir

	[ -x "$PROG" ] || {
		echo "[dove] ERROR: $PROG not found or not executable" >> "$log_file"
		return 1
	}

	mkdir -p "$(dirname "$config_file")"
	[ -f "$config_file" ] || {
		echo "[dove] ERROR: configuration file not found: $config_file" >> "$log_file"
		return 1
	}
	# 配置里可能有节点密码，收紧权限（与 joey 一致）
	chmod 0600 "$config_file" 2>/dev/null || true

	_ensure_geodata
	_rotate_log

	if [ "$validate_start" = "1" ]; then
		if ! _check_config >> "$log_file" 2>&1; then
			echo "[dove] ERROR: config validation failed, aborting start." >> "$log_file"
			return 1
		fi
	fi

	procd_open_instance "$NAME"
		procd_set_param command "$PROG" run
		procd_append_param command -c "$config_file"
		procd_append_param command --logfile "$log_file"
		procd_append_param command --service-pid-file "$pid_file"
		procd_append_param command --service-progress-file "$progress_file"
		procd_append_param command --service-abort-file "$abort_file"
		[ "$disable_timestamp" = "1" ] && procd_append_param command --disable-timestamp

		procd_set_param limits core="unlimited"
		procd_set_param limits nofile="$nofile $nofile"
		procd_set_param limits nproc="$nproc $nproc"
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_set_param term_timeout "$term_timeout"
		if [ "$respawn" = "1" ]; then
			procd_set_param respawn "$respawn_threshold" "$respawn_timeout" "$respawn_retry"
		fi
	procd_close_instance
}

stop_service() {
	_ensure_logdir
	echo "[dove] Service stopping." >> "$log_file"
	# core 在 SIGTERM 时会自己清理 pidfile；这里只兜底
	rm -f "$pid_file" 2>/dev/null
}

# 配置改动后热重载：先校验，再 SIGUSR1；进程不在或重载失败则退化成重启
hot_reload() {
	load_dove_config
	_ensure_logdir

	if [ "$validate_start" = "1" ] && ! _check_config >> "$log_file" 2>&1; then
		echo "[dove] ERROR: hot_reload aborted: config validation failed." >> "$log_file"
		return 1
	fi

	local pid=""
	[ -r "$pid_file" ] && pid="$(cat "$pid_file" 2>/dev/null)"
	[ -n "$pid" ] || pid="$(pidof dove 2>/dev/null | awk '{print $1}')"

	if [ -n "$pid" ] && "$PROG" reload \
			--service-pid-file "$pid_file" \
			--service-progress-file "$progress_file" \
			--service-abort-file "$abort_file" >/dev/null 2>&1; then
		logger -t dove "hot-reload triggered (pid=$pid)"
		echo "[dove] Hot-reload triggered (pid=$pid)." >> "$log_file"
		return 0
	fi

	echo "[dove] Hot-reload unavailable, falling back to restart." >> "$log_file"
	stop
	start
}

check_config() {
	load_dove_config
	_check_config && echo "config OK: $config_file"
}

reload_service() {
	hot_reload
}

service_triggers() {
	procd_add_reload_trigger "$NAME"
}
