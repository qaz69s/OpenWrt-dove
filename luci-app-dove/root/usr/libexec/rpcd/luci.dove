#!/bin/sh

readonly NAME="dove"
readonly PROG="/usr/bin/dove"
readonly LOG="/var/log/dove.log"

. /lib/functions.sh
. /usr/share/libubox/jshn.sh

is_enabled()      { "/etc/init.d/${1}" enabled; }
is_running()      { [ "$(ubus call service list "{ 'name': '$1' }" \
                        | jsonfilter -q -e "@['$1'].instances[*].running" \
                        | uniq)" = 'true' ]; }
# dove 是 DaeNext core，没有 --version：改用 `dove identity` 的 version 字段
# （形如 "daed rust-native product 3.1.0 dae-core=... target=..."），取其中纯版本号
get_version()     { "$PROG" identity 2>/dev/null \
                      | jsonfilter -e '@.version' 2>/dev/null \
                      | awk '{for(i=1;i<=NF;i++) if ($i ~ /^[0-9]+\.[0-9]+\.[0-9]+$/) {print $i; exit}}'; }
print_json_bool() { json_init; json_add_boolean "$1" "$2"; json_dump; json_cleanup; }

# ── get_init_status ────────────────────────────────────────────────────────────
# 通过 ps + /proc 取进程 PID（不依赖 ubus JSON 转义）
_get_dae_pid() {
	local pid
	# 方法1: ps 匹配 dove run 命令行（procd 起的是 /usr/bin/dove run -c ...）
	pid="$(ps 2>/dev/null | awk '$0~/[d]ove.*run/{print $1; exit}')"
	# 方法2: pidof（OpenWrt busybox 支持）
	[ -z "$pid" ] && pid="$(pidof dove 2>/dev/null | awk '{print $1}')"
	echo "$pid"
}

# 接受可选 PID 参数，避免调用方重复执行 ps/pidof
get_proc_uptime() {
	local pid="${1:-$(_get_dae_pid)}"
	[ -z "$pid" ] && { echo 0; return; }
	local starttime sys_uptime
	starttime="$(awk '{print $22}' /proc/"$pid"/stat 2>/dev/null)"
	sys_uptime="$(awk '{printf "%d", $1}' /proc/uptime 2>/dev/null)"
	[ -z "$starttime" ] || [ -z "$sys_uptime" ] && { echo 0; return; }
	echo $(( sys_uptime - starttime / 100 ))
}

get_proc_mem_mb() {
	local pid="${1:-$(_get_dae_pid)}"
	[ -z "$pid" ] && { echo 0; return; }
	# VmRSS 单位 kB，转成 MB 保留一位小数
	awk '/VmRSS/{printf "%.1f", $2/1024; exit}' /proc/"$pid"/status 2>/dev/null || echo 0
}

get_init_status() {
	local name="${1:-$NAME}"
	local version; version="$(get_version)"
	local running=0
	is_running "$name" && running=1
	local uptime=0 mem=0
	if [ "$running" = "1" ]; then
		# 优化: 只调用一次 _get_dae_pid，pid 结果复用给 uptime 和 mem
		local pid; pid="$(_get_dae_pid)"
		uptime="$(get_proc_uptime "$pid")"
		mem="$(get_proc_mem_mb "$pid")"
	fi
	json_init
	json_add_object "$name"
	if is_enabled "$name"; then json_add_boolean 'enabled' '1'
	else                        json_add_boolean 'enabled' '0'; fi
	json_add_boolean 'running' "$running"
	json_add_string  'version' "$version"
	json_add_int     'uptime'  "${uptime:-0}"
	json_add_string  'mem'     "${mem:-0}"
	json_close_object
	json_dump; json_cleanup
}

# ── get_mem ────────────────────────────────────────────────────────────────────
# Bug fix: 前端已通过 getInitStatus 掌握 running 状态，此处无需重复调用 is_running()
# (is_running 内部走 ubus call + jsonfilter，每秒触发代价较重)
# 直接用 PID 判断进程是否存活，省去 ubus 调用
get_mem() {
	local pid mem
	pid="$(_get_dae_pid)"
	if [ -n "$pid" ]; then
		mem="$(awk '/VmRSS/{printf "%.1f", $2/1024; exit}' /proc/"$pid"/status 2>/dev/null)"
	fi
	json_init
	json_add_string 'mem' "${mem:-0}"
	json_dump; json_cleanup
}


set_init_action() {
	# 安全加固: 使用常量 $NAME 而非用户传入的 $name 拼接命令，
	# 防止 name 参数含 shell 元字符时通过 eval 执行任意命令
	local action="$1" cmd
	case $action in
		enable)
			# Bug fix: 同步 UCI enabled=1，否则 reload_service() 会在 UCI 触发时
			# 因为看到 enabled=0 而把已运行的服务 stop 掉，造成"设了自启但没自启"的现象
			cmd="/etc/init.d/${NAME} enable \
			  && uci set ${NAME}.settings.enabled=1 \
			  && uci commit ${NAME}" ;;
		disable)
			cmd="/etc/init.d/${NAME} disable \
			  && uci set ${NAME}.settings.enabled=0 \
			  && uci commit ${NAME}" ;;
		start|stop|restart)
			cmd="/etc/init.d/${NAME} ${action}" ;;
		reload_config)
			# Bug fix: reload_config 在 init 脚本里不存在，应改用 hot_reload
			cmd="/etc/init.d/${NAME} hot_reload" ;;
		enable_start)
			cmd="/etc/init.d/${NAME} enable \
			  && uci set ${NAME}.settings.enabled=1 \
			  && uci commit ${NAME} \
			  && /etc/init.d/${NAME} start" ;;
	esac
	if [ -n "$cmd" ] && eval "$cmd" >/dev/null 2>&1; then
		print_json_bool "result" '1'
	else
		print_json_bool "result" '0'
	fi
}

# ── clear_log ──────────────────────────────────────────────────────────────────
clear_log() {
	if : > "$LOG" 2>/dev/null; then
		print_json_bool "result" '1'
	else
		print_json_bool "result" '0'
	fi
}

# ── RPC dispatcher ─────────────────────────────────────────────────────────────
case "$1" in
	list)
		json_init
		json_add_object "getInitStatus"
			json_add_string 'name' "name"
		json_close_object
		json_add_object "getMem"
			json_add_string 'name' "name"
		json_close_object
		json_add_object "setInitAction"
			json_add_string 'name'   "name"
			json_add_string 'action' "action"
		json_close_object
		json_add_object "clearLog"; json_close_object
		json_dump; json_cleanup
		;;
	call)
		case "$2" in
			getInitStatus)
				read -r input; json_load "$input"
				json_get_var name 'name'; json_cleanup
				get_init_status "$name" ;;
			getMem)
				read -r input; json_load "$input"
				json_get_var name 'name'; json_cleanup
				get_mem "$name" ;;
			setInitAction)
				read -r input; json_load "$input"
				json_get_var action 'action'; json_cleanup
				set_init_action "$action" ;;
			clearLog)
				clear_log ;;
		esac ;;
esac
