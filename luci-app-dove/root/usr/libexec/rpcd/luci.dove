#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-only
#
# rpcd helper for luci-app-dove
#
# Dove 跑的是 DaeNext 的 **core only** 二进制（无 product-api：没有 SQLite、没有
# REST、没有 Web UI）。所以这里的胶水比 deer 简单得多 —— 配置就是一份文本文件
# （/etc/dove/config.dae），LuCI 通过 fs.read/fs.write 直接读写，
# 这个 helper 只负责状态/日志/服务控制/配置校验。
#
# ubus -v list luci.dove
# ubus call luci.dove getInitStatus '{"name":"dove"}'
# ubus call luci.dove validateConfig

readonly NAME=dove
readonly PROG=/usr/bin/dove
readonly DEFAULT_CONFIG_FILE=/etc/dove/config.dae
readonly DEFAULT_LOG=/var/log/dove.log
readonly DEFAULT_PID_FILE=/var/run/dove.pid
readonly LOG_LINES=400

. /lib/functions.sh
. /usr/share/libubox/jshn.sh

is_enabled()      { "/etc/init.d/${1}" enabled >/dev/null 2>&1; }
is_running()      { [ "$(ubus call service list "{ 'name': '$1' }" \
                        | jsonfilter -q -e "@['$1'].instances[*].running" \
                        | uniq)" = 'true' ]; }
print_json_bool() { json_init; json_add_boolean "$1" "$2"; json_dump; json_cleanup; }
print_error()     { json_init; json_add_boolean 'ok' '0'; json_add_string 'error' "$1"; json_dump; json_cleanup; }

uci_get() {
	local v
	v="$(uci -q get "$NAME.settings.$1")"
	[ -n "$v" ] && echo "$v"
}

config_file() { local v; v="$(uci_get config_file)"; echo "${v:-$DEFAULT_CONFIG_FILE}"; }
log_file()    { local v; v="$(uci_get log_file)";    echo "${v:-$DEFAULT_LOG}"; }
pid_file()    { local v; v="$(uci_get pid_file)";    echo "${v:-$DEFAULT_PID_FILE}"; }

_get_dove_pid() {
	local pid=""
	[ -r "$(pid_file)" ] && pid="$(cat "$(pid_file)" 2>/dev/null)"
	[ -z "$pid" ] && pid="$(pidof dove 2>/dev/null | awk '{print $1}')"
	echo "$pid"
}

# core 没有 --version，用 `dove identity` 的 version 字段
get_version() {
	[ -x "$PROG" ] || { echo ''; return 0; }
	"$PROG" identity 2>/dev/null | jsonfilter -e '@.version' 2>/dev/null
}

# ── 状态 ──────────────────────────────────────────────────────────────────────
get_proc_uptime() {
	local pid="${1:-$(_get_dove_pid)}"
	[ -z "$pid" ] && { echo 0; return; }
	local starttime sys_uptime
	starttime="$(awk '{print $22}' /proc/"$pid"/stat 2>/dev/null)"
	sys_uptime="$(awk '{printf "%d", $1}' /proc/uptime 2>/dev/null)"
	[ -z "$starttime" ] || [ -z "$sys_uptime" ] && { echo 0; return; }
	echo $(( sys_uptime - starttime / 100 ))
}

get_proc_mem_mb() {
	local pid="${1:-$(_get_dove_pid)}"
	[ -z "$pid" ] && { echo 0; return; }
	awk '/VmRSS/{printf "%.1f", $2/1024; exit}' /proc/"$pid"/status 2>/dev/null || echo 0
}

get_init_status() {
	local name="${1:-$NAME}"
	local version running=0 uptime=0 mem=0
	version="$(get_version)"
	is_running "$name" && running=1
	if [ "$running" = "1" ]; then
		local pid; pid="$(_get_dove_pid)"
		uptime="$(get_proc_uptime "$pid")"
		mem="$(get_proc_mem_mb "$pid")"
	fi

	json_init
	json_add_object "$name"
	if is_enabled "$name"; then json_add_boolean 'enabled' '1'
	else                        json_add_boolean 'enabled' '0'; fi
	json_add_boolean 'running'  "$running"
	json_add_string  'version'  "$version"
	[ -n "$version" ] && json_add_boolean 'installed' '1' || json_add_boolean 'installed' '0'
	json_add_int     'uptime'   "${uptime:-0}"
	json_add_string  'mem'      "${mem:-0}"
	json_add_string  'config'   "$(config_file)"
	json_add_string  'log'      "$(log_file)"
	json_add_string  'pid'      "$(_get_dove_pid)"
	json_close_object
	json_dump; json_cleanup
}

get_mem() {
	local pid="$( _get_dove_pid )" mem
	[ -n "$pid" ] && mem="$(get_proc_mem_mb "$pid")"
	json_init
	json_add_string 'mem' "${mem:-0}"
	json_dump; json_cleanup
}

# 完整 identity JSON（诊断用）
get_identity() {
	[ -x "$PROG" ] || { print_error "$PROG not found"; return 0; }
	local raw; raw="$("$PROG" identity 2>/dev/null)"
	[ -n "$raw" ] || { print_error 'identity command failed'; return 0; }
	json_init
	json_add_boolean 'ok' '1'
	json_add_string  'raw' "$raw"
	json_add_string  'version' "$(jsonfilter -s "$raw" -e '@.version' 2>/dev/null)"
	json_dump; json_cleanup
}

# 校验配置：不带参数校验现网配置；带 content 校验未保存的文本
validate_config() {
	local content="$1" target tmp ok=0 err=''
	target="$(config_file)"
	if [ -n "$content" ]; then
		tmp="/tmp/dove-validate.$$.dae"
		umask 077
		printf '%s\n' "$content" > "$tmp" || { print_error 'cannot write temp file'; return 0; }
		target="$tmp"
	fi
	if out="$("$PROG" validate -c "$target" 2>&1)"; then
		ok=1
	else
		err="$out"
		[ -n "$err" ] || err='validate failed'
	fi
	[ -n "$tmp" ] && rm -f "$tmp"

	json_init
	json_add_boolean 'ok' "$ok"
	json_add_string  'error' "$err"
	json_add_string  'target' "$target"
	json_dump; json_cleanup
}

# ── 日志 ──────────────────────────────────────────────────────────────────────
get_log() {
	local source="$1" path lines=''
	case "$source" in
		syslog)
			path="logread | grep -iE 'dove'"
			lines="$(logread 2>/dev/null | grep -iE 'dove' | tail -n "$LOG_LINES")"
			;;
		*)
			source="core"
			path="$(log_file)"
			[ -f "$path" ] && lines="$(tail -n "$LOG_LINES" "$path" 2>/dev/null)"
			;;
	esac
	json_init
	json_add_string 'source' "$source"
	json_add_string 'path'   "$path"
	json_add_string 'log'    "$lines"
	json_dump; json_cleanup
}

clear_log() {
	local file; file="$(log_file)"
	if [ -f "$file" ]; then
		if : > "$file" 2>/dev/null; then print_json_bool "result" '1'
		else                            print_json_bool "result" '0'; fi
	else
		print_json_bool "result" '0'
	fi
}

# ── 服务控制 ──────────────────────────────────────────────────────────────────
set_init_action() {
	local action="$1" cmd
	case "$action" in
		enable)  cmd="/etc/init.d/${NAME} enable" ;;
		disable) cmd="/etc/init.d/${NAME} disable" ;;
		start)   cmd="/etc/init.d/${NAME} start" ;;
		stop)    cmd="/etc/init.d/${NAME} stop" ;;
		restart) cmd="/etc/init.d/${NAME} restart" ;;
		reload)  cmd="/etc/init.d/${NAME} reload" ;;
		hot_reload) cmd="/etc/init.d/${NAME} hot_reload" ;;
		enable_start)
			cmd="/etc/init.d/${NAME} enable && /etc/init.d/${NAME} start" ;;
	esac
	if [ -n "$cmd" ] && eval "$cmd" >/dev/null 2>&1; then
		print_json_bool "result" '1'
	else
		print_json_bool "result" '0'
	fi
}

# ── RPC dispatcher ────────────────────────────────────────────────────────────
case "$1" in
	list)
		json_init
		json_add_object "getInitStatus"
			json_add_string 'name' "name"
		json_close_object
		json_add_object "getMem"
			json_add_string 'name' "name"
		json_close_object
		json_add_object "getIdentity"; json_close_object
		json_add_object "getLog"
			json_add_string 'source' "source"
		json_close_object
		json_add_object "clearLog"; json_close_object
		json_add_object "validateConfig"
			json_add_string 'content' "content"
		json_close_object
		json_add_object "setInitAction"
			json_add_string 'name'   "name"
			json_add_string 'action' "action"
		json_close_object
		json_dump; json_cleanup
		;;
	call)
		case "$2" in
			getInitStatus)
				read -r input; json_load "$input"
				json_get_var name 'name'; json_cleanup
				[ "$name" = "$NAME" ] || { print_json_bool "result" '0'; exit 0; }
				get_init_status "$name" ;;
			getMem)
				read -r input; json_load "$input"
				json_get_var name 'name'; json_cleanup
				[ "$name" = "$NAME" ] || { print_json_bool "result" '0'; exit 0; }
				get_mem "$name" ;;
			getIdentity)
				get_identity ;;
			getLog)
				read -r input; json_load "$input"
				json_get_var source 'source'; json_cleanup
				get_log "$source" ;;
			clearLog)
				clear_log ;;
			validateConfig)
				read -r input; json_load "$input"
				json_get_var content 'content'; json_cleanup
				validate_config "$content" ;;
			setInitAction)
				read -r input; json_load "$input"
				json_get_var action 'action'; json_cleanup
				set_init_action "$action" ;;
		esac ;;
esac
