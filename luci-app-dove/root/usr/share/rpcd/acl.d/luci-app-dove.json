{
	"luci-app-dove": {
		"description": "Grant UCI, ubus and config-file access to LuCI app Dove",
		"read": {
			"ubus": {
				"luci.dove": [
					"getInitStatus",
					"getMem",
					"getIdentity",
					"getLog"
				]
			},
			"file": {
				"/etc/dove/config.dae": [ "read" ],
				"/var/log/dove.log": [ "read" ]
			},
			"uci": [ "dove" ]
		},
		"write": {
			"ubus": {
				"luci.dove": [
					"setInitAction",
					"clearLog",
					"validateConfig"
				],
				"uci": [
					"get",
					"set",
					"commit"
				]
			},
			"file": {
				"/etc/dove/config.dae": [ "write" ],
				"/var/log/dove.log": [ "write" ]
			},
			"uci": [ "dove" ]
		}
	}
}
