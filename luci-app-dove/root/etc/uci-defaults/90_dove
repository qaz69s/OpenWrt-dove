#!/bin/sh
# uci-defaults: first-install initialisation for luci-app-dove.
# The dove kernel package already owns /etc/init.d/dove, /etc/config/dove
# and /usr/bin/dove; this script only wires up permissions and autostart.

# Fix rpcd helper permissions (package installer may not set +x on some builds)
chmod +x /usr/libexec/rpcd/luci.dove

# Dove 配置目录与日志（配置里可能有节点密码，0600）
mkdir -p /etc/dove /var/log
chmod 0700 /etc/dove 2>/dev/null || true
chmod 0600 /etc/dove/config.dae 2>/dev/null || true
touch /var/log/dove.log 2>/dev/null || true

# geodata：core 的 geodata 目录 = 配置文件所在目录（/etc/dove）。
# /etc/dove -> /usr/share/v2ray 必须用绝对目标：写成 ../v2ray/... 会解析成
# /etc/v2ray/...（悬空软链）。-e 判断能自动纠正旧版错链。
[ -e /etc/dove/geoip.dat ]   || ln -sf /usr/share/v2ray/geoip.dat   /etc/dove/geoip.dat   2>/dev/null || true
[ -e /etc/dove/geosite.dat ] || ln -sf /usr/share/v2ray/geosite.dat /etc/dove/geosite.dat 2>/dev/null || true
# 解析器真正会找的兜底目录（实测：/etc/dove, /etc/daed, /usr/local/share/daed,
# /usr/share/daed, /.local/share/daed）—— /usr/share/dae 不在列表里
mkdir -p /usr/share/daed
[ -e /usr/share/daed/geoip.dat ]   || ln -sf ../v2ray/geoip.dat   /usr/share/daed/geoip.dat   2>/dev/null || true
[ -e /usr/share/daed/geosite.dat ] || ln -sf ../v2ray/geosite.dat /usr/share/daed/geosite.dat 2>/dev/null || true

# Restart rpcd so the new ACL / helper are picked up immediately
/etc/init.d/rpcd restart

# Enable the dove service (do not auto-start; user enables via LuCI)
/etc/init.d/dove enable

return 0
